  "add_charge_schedule": {
    "command": "add_charge_schedule",
    "scope": "vehicle_charging_cmds",
    "effect": "Add or modify a location-based charge schedule",
    "domain": "INFO",
    "properties": {
      "id": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4294967295,
        "description": "Exact schedule ID; no automatic ID substitution"
      },
      "lat": {
        "type": "number",
        "minimum": -90,
        "maximum": 90
      },
      "lon": {
        "type": "number",
        "minimum": -180,
        "maximum": 180
      },
      "days_of_week": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "description": "Comma-separated day names or ALL/WEEKDAYS",
        "pattern": "^(ALL|WEEKDAYS|(MON|TUES|WED|THURS|FRI|SAT|SUN)(,(MON|TUES|WED|THURS|FRI|SAT|SUN))*)$"
      },
      "enabled": {
        "type": "boolean"
      },
      "one_time": {
        "type": "boolean"
      },
      "start_time": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1439,
        "description": "Vehicle local minutes after midnight"
      },
      "end_time": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1439
      },
      "start_enabled": {
        "type": "boolean"
      },
      "end_enabled": {
        "type": "boolean"
      }
    },
    "requires_park": false,
    "required_facts": [],
    "support": "hardware_or_firmware_unverified",
    "sensitive_parameters": [
      "lat",
      "lon"
    ]
  },
